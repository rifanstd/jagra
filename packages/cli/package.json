{
  "name": "jagra",
  "version": "0.0.0",
  "private": true,
  "description": "Run a project's Maestro flows from the command line.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jagra": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @jagra/core build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jagra/core": "workspace:*"
  }
}
