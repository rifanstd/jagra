{
  "name": "@jagra/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fakes": {
      "source": "./src/fakes/index.ts",
      "types": "./dist/fakes/index.d.ts",
      "default": "./dist/fakes/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tools": "vitest run --config vitest.tools.config.js",
    "test:device": "vitest run --config vitest.device.config.js"
  },
  "dependencies": {
    "@devicefarmer/adbkit-apkreader": "4.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
