{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "customConditions": ["source"],
    "paths": { "@renderer/*": ["./src/*"] }
  },
  "include": ["src", "../shared"]
}
